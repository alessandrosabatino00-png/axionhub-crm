{
 "1": [
  {
   "start": 0.6,
   "end": 1.984,
   "text": "Hai deciso di vendere casa."
  },
  {
   "start": 2.384,
   "end": 4.101,
   "text": "Prima domanda, quella che condiziona"
  },
  {
   "start": 4.101,
   "end": 5.437,
   "text": "tutto il resto: quanto vale?"
  }
 ],
 "2": [
  {
   "start": 0.6,
   "end": 3.206,
   "text": "Prima di tutto, una distinzione che confonde molti."
  },
  {
   "start": 3.606,
   "end": 5.094,
   "text": "Il valore è quanto la casa vale"
  },
  {
   "start": 5.094,
   "end": 6.679,
   "text": "per il mercato in questo momento."
  },
  {
   "start": 7.079,
   "end": 9.318,
   "text": "Il prezzo di annuncio è quello che decidi di chiedere."
  },
  {
   "start": 9.718,
   "end": 11.051,
   "text": "Il prezzo di vendita è quello"
  },
  {
   "start": 11.051,
   "end": 12.476,
   "text": "che finisce scritto nel rogito,"
  },
  {
   "start": 12.476,
   "end": 13.878,
   "text": "ed è l'unico che conta davvero."
  },
  {
   "start": 14.278,
   "end": 16.451,
   "text": "Spesso non coincidono: tra annuncio e"
  },
  {
   "start": 16.451,
   "end": 18.506,
   "text": "vendita c'è di mezzo la trattativa."
  }
 ],
 "10": [
  {
   "start": 0.6,
   "end": 3.275,
   "text": "Prima di parlare con qualcuno, raccogli i dati:"
  },
  {
   "start": 3.275,
   "end": 5.039,
   "text": "visura e planimetria catastale,"
  },
  {
   "start": 5.039,
   "end": 7.267,
   "text": "anno di costruzione, classe energetica,"
  },
  {
   "start": 7.267,
   "end": 8.41,
   "text": "spese di condominio."
  },
  {
   "start": 8.81,
   "end": 10.605,
   "text": "Poi ottieni una fascia di valore,"
  },
  {
   "start": 10.605,
   "end": 12.999,
   "text": "e confrontala con almeno due professionisti."
  }
 ]
